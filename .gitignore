import streamlit as st
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from scipy.cluster.hierarchy import dendrogram, linkage


# ----- PAGE CONFIG -----

st.set_page_config(
    page_title="Netflix Movies Analysis Dashboard",
    page_icon="🎬",
    layout="wide"
)


# ----- SIDEBAR -----

st.sidebar.title("🎬 Netflix Dashboard")


option = st.sidebar.selectbox(
    "Select Section",
    [
        "🏠 Dashboard",
        "📂 Dataset",
        "📊 Analysis",
        "ℹ️ About"
    ]
)


# ----- LOAD DATA -----

df = None


if option == "📂 Dataset" or option == "📊 Analysis":

    uploaded_file = st.sidebar.file_uploader(
        "Upload Netflix CSV",
        type=["csv"]
    )

    if uploaded_file is not None:
        df = pd.read_csv(uploaded_file)



# ----- DASHBOARD -----

if option == "🏠 Dashboard":

    st.title(
        "🎬 Netflix Movies Analysis Dashboard"
    )


    st.markdown(
        """
        ### 📺 Explore Netflix Movies and TV Shows

        This dashboard analyzes Netflix content
        using data visualization techniques.
        """
    )

    st.info(
        "Please upload Netflix CSV file from Dataset section."
    )



# ----- DATASET -----

elif option == "📂 Dataset":

    st.title(
        "📂 Dataset Information"
    )


    if df is not None:


        st.subheader(
            "Dataset Preview"
        )


        st.dataframe(
            df.head(10),
            use_container_width=True
        )



        st.subheader(
            "Dataset Size"
        )


        col1, col2 = st.columns(2)


        with col1:

            st.metric(
                "Total Rows",
                df.shape[0]
            )


        with col2:

            st.metric(
                "Total Columns",
                df.shape[1]
            )



        st.subheader(
            "Dataset Information"
        )


        info = pd.DataFrame(
            {
                "Column Name": df.columns,
                "Data Type": df.dtypes.astype(str),
                "Missing Values": df.isnull().sum()
            }
        )


        st.dataframe(
            info,
            use_container_width=True
        )



        st.subheader(
            "Missing Values"
        )


        st.write(
            df.isnull().sum()
        )



        st.subheader(
            "Duplicate Values"
        )


        duplicate = df.duplicated().sum()


        st.write(
            "Total Duplicate Rows:",
            duplicate
        )



        st.subheader(
            "Statistical Summary"
        )


        st.dataframe(
            df.describe(),
            use_container_width=True
        )


    else:

        st.warning(
            "Please upload CSV file from sidebar."
        )# ---------------- ANALYSIS ----------------

elif option == "📊 Analysis":

    st.title(
        "📊 Netflix Data Analysis"
    )


    if df is not None:

# ----- BAR CHART -----

        if "type" in df.columns:

            st.subheader(
                "📊 Movie & TV Show Count"
            )


            count = df["type"].value_counts()


            fig, ax = plt.subplots()


            ax.bar(
                count.index,
                count.values
            )


            ax.set_xlabel(
                "Content Type"
            )

            ax.set_ylabel(
                "Count"
            )

            ax.set_title(
                "Movie vs TV Show"
            )


            st.pyplot(fig)

# ----- PIE CHART -----

        if "type" in df.columns:

            st.subheader(
                "🥧 Content Distribution"
            )


            fig, ax = plt.subplots()


            ax.pie(
                count.values,
                labels=count.index,
                autopct="%1.1f%%"
            )


            ax.set_title(
                "Movie and TV Show Percentage"
            )


            st.pyplot(fig)

# ----- LINE CHART -----

        if "release_year" in df.columns:


            st.subheader(
                "📈 Release Year Trend"
            )


            year = (
                df["release_year"]
                .value_counts()
                .sort_index()
            )


            fig, ax = plt.subplots()


            ax.plot(
                year.index,
                year.values,
                marker="o"
            )


            ax.set_xlabel(
                "Release Year"
            )

            ax.set_ylabel(
                "Number of Shows"
            )

            ax.set_title(
                "Netflix Release Trend"
            )


            st.pyplot(fig)

# ----- HISTOGRAM -----

        if "imdb_rating" in df.columns:


            st.subheader(
                "📉 Rating Histogram"
            )


            fig, ax = plt.subplots()


            ax.hist(
                df["imdb_rating"].dropna(),
                bins=10
            )


            ax.set_xlabel(
                "IMDb Rating"
            )

            ax.set_ylabel(
                "Frequency"
            )


            st.pyplot(fig)

# ----- SCATTER PLOT -----

        if (
            "imdb_rating" in df.columns
            and
            "popularity" in df.columns
        ):


            st.subheader(
                "🔵 Rating vs Popularity"
            )


            fig, ax = plt.subplots()


            ax.scatter(
                df["imdb_rating"],
                df["popularity"]
            )


            ax.set_xlabel(
                "IMDb Rating"
            )

            ax.set_ylabel(
                "Popularity"
            )


            ax.set_title(
                "Popularity Analysis"
            )


            st.pyplot(fig)

# ----- BOX PLOT -----

        if "runtime_min" in df.columns:


            st.subheader(
                "📦 Runtime Box Plot"
            )


            fig, ax = plt.subplots()


            ax.boxplot(
                df["runtime_min"].dropna()
            )


            ax.set_ylabel(
                "Runtime Minutes"
            )


            ax.set_title(
                "Runtime Distribution"
            )


            st.pyplot(fig)

# ----- TOP GENRES ------

        if "listed_in" in df.columns:


            st.subheader(
                "🎭 Top Genres"
            )


            genre = (
                df["listed_in"]
                .dropna()
                .str.split(",")
                .explode()
                .str.strip()
            )


            top_genre = (
                genre
                .value_counts()
                .head(10)
            )


            fig, ax = plt.subplots(
                figsize=(8,4)
            )


            ax.bar(
                top_genre.index,
                top_genre.values
            )


            plt.xticks(
                rotation=45
            )


            ax.set_title(
                "Top Genres"
            )


            st.pyplot(fig)

# ----- TOP COUNTRIES -----

        if "country" in df.columns:


            st.subheader(
                "🌍 Top Countries"
            )


            country = (
                df["country"]
                .dropna()
                .str.split(",")
                .explode()
                .str.strip()
            )


            top_country = (
                country
                .value_counts()
                .head(10)
            )


            fig, ax = plt.subplots(
                figsize=(8,4)
            )


            ax.bar(
                top_country.index,
                top_country.values
            )


            plt.xticks(
                rotation=45
            )


            ax.set_title(
                "Top Countries"
            )


            st.pyplot(fig)

 # ----- TOP DIRECTORS -----

        if "director" in df.columns:


            st.subheader(
                "🎥 Top Directors"
            )


            director = (
                df["director"]
                .dropna()
                .str.split(",")
                .explode()
                .str.strip()
            )


            top_director = (
                director
                .value_counts()
                .head(10)
            )


            fig, ax = plt.subplots(
                figsize=(8,4)
            )


            ax.bar(
                top_director.index,
                top_director.values
            )


            plt.xticks(
                rotation=45
            )


            ax.set_title(
                "Top Directors"
            )


            st.pyplot(fig)

# ----- HEATMAP -----

        st.subheader(
            "🔥 Correlation Heatmap"
        )


        numeric = df.select_dtypes(
            include="number"
        )


        if len(numeric.columns) > 1:


            fig, ax = plt.subplots(
                figsize=(8,5)
            )


            sns.heatmap(
                numeric.corr(),
                annot=True,
                cmap="coolwarm",
                ax=ax
            )


            st.pyplot(fig)


        else:

            st.warning(
                "Need more numeric columns for Heatmap"
            )

# ----- DENDROGRAM -----

        st.subheader(
            "🌳 Dendrogram"
        )


        if len(numeric.columns) > 1:


            data = numeric.dropna()


            linked = linkage(
                data,
                method="ward"
            )


            fig, ax = plt.subplots(
                figsize=(10,5)
            )


            dendrogram(
                linked,
                ax=ax
            )


            ax.set_title(
                "Hierarchical Clustering"
            )


            st.pyplot(fig)


        else:

            st.warning(
                "Need more numeric columns for Dendrogram"
            )


    else:

        st.warning(
            "Please upload CSV file first."
        )
# ----- ABOUT -----
elif option == "ℹ️ About":

    st.title("ℹ️ About Project")

    st.header("🎬 Netflix Movies Analysis Dashboard")

    st.write(
        "This project analyzes Netflix Movies and TV Shows using "
        "Python and Streamlit. It helps users explore the dataset "
        "through visualizations and machine learning prediction."
    )

    st.header("🛠 Technologies Used")

    st.markdown("""
    - Python
    - Streamlit
    - Pandas
    - Matplotlib
    - Seaborn
    - Scikit-learn
    - Scipy
    """)

    st.header("📂 Dataset")

    st.markdown("""
    - Netflix Movies & TV Shows Dataset
    - 500+ Records
    - Multiple Features
    - Movies and TV Shows Information
    """)

    st.header("✨ Key Features")

    st.markdown("""
    - Dashboard Overview
    - Dataset Upload
    - Dataset Preview
    - Data Analysis
    - Interactive Charts
    - Correlation Heatmap
    - Dendrogram
    - Machine Learning Prediction
    """)

    st.header("🎯 Objective")

    st.write(
        "To analyze Netflix Movies and TV Shows using data visualization "
        "and machine learning techniques."
    )

    st.header("👨‍💻 Developed By")

    st.success("Pranjal Shinde\n\nDiploma IT")